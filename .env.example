# Privy - Required for wallet authentication
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here

# Gemini AI - Required for AI chat assistant
# Get your API key at https://aistudio.google.com/apikey
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Plausible Analytics - Optional, for traffic analytics
# Sign up at https://plausible.io or self-host via Docker
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com
# NEXT_PUBLIC_PLAUSIBLE_CUSTOM_DOMAIN=  (only for self-hosted)
NEXT_PUBLIC_PLAUSIBLE_SHARED_LINK=https://plausible.io/share/yourdomain.com?auth=YOUR_AUTH_TOKEN
